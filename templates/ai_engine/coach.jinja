{% extends "layouts/app.jinja" %}
{% block page_title %}AI Relationship Coach{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto flex flex-col" style="height: calc(100vh - 120px);">

  {# Header #}
  <div class="flex items-center justify-between mb-4 flex-shrink-0">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 bg-gradient-to-br from-rose-400 to-pink-600 rounded-full flex items-center justify-center">
        <span class="text-white font-bold">H</span>
      </div>
      <div>
        <h2 class="text-base font-bold text-gray-900">HarmonyAI Coach</h2>
        <p class="text-xs text-green-500 font-medium">● Online</p>
      </div>
    </div>
    <div class="flex items-center gap-3">
      <a href="{{ url('relationships:detail', pk=relationship.pk) }}"
         class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back
      </a>
      <button
        hx-delete="{{ url('ai_engine:coach', rel_pk=relationship.pk) }}"
        hx-target="#chat-messages"
        hx-swap="innerHTML"
        hx-confirm="Clear conversation history?"
        class="text-xs text-gray-400 hover:text-red-500 transition-colors">
        Clear
      </button>
      {{ csrf_input }}
    </div>
  </div>

  {# Context pill #}
  <div class="mb-3 flex-shrink-0">
    <div class="inline-flex items-center gap-1.5 bg-rose-50 border border-rose-100 rounded-full px-3 py-1">
      <svg class="w-3.5 h-3.5 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <span class="text-xs text-rose-600 font-medium">Context: {{ relationship.get_relationship_type_display() }} relationship</span>
    </div>
  </div>

  {# Messages area #}
  <div id="chat-messages"
       class="flex-1 overflow-y-auto bg-gray-50 rounded-2xl border border-gray-200 p-4 space-y-1"
       hx-target="this"
       hx-swap="beforeend">

    {# Welcome if no history #}
    {% if not history %}
    <div class="flex justify-start mb-4">
      <div class="flex items-start gap-2.5 max-w-[85%]">
        <div class="w-7 h-7 bg-gradient-to-br from-rose-400 to-pink-600 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
          <span class="text-white text-xs font-bold">H</span>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl rounded-bl-sm px-4 py-2.5">
          <p class="text-sm text-gray-700 leading-relaxed">
            Hi! I'm your HarmonyAI relationship coach. I can help you understand relationship patterns,
            work through conflicts, and strengthen your connection. What's on your mind?
          </p>
        </div>
      </div>
    </div>
    {% else %}
      {% for msg in history %}
        {% if msg.role == 'user' %}
        <div class="flex justify-end mb-3">
          <div class="max-w-[80%] bg-rose-500 text-white rounded-2xl rounded-br-sm px-4 py-2.5">
            <p class="text-sm leading-relaxed">{{ msg.content }}</p>
          </div>
        </div>
        {% else %}
        <div class="flex justify-start mb-3">
          <div class="flex items-start gap-2.5 max-w-[85%]">
            <div class="w-7 h-7 bg-gradient-to-br from-rose-400 to-pink-600 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
              <span class="text-white text-xs font-bold">H</span>
            </div>
            <div class="bg-white border border-gray-200 rounded-2xl rounded-bl-sm px-4 py-2.5">
              <p class="text-sm text-gray-700 leading-relaxed">{{ msg.content }}</p>
            </div>
          </div>
        </div>
        {% endif %}
      {% endfor %}
    {% endif %}

    {# Typing indicator (HTMX hx-indicator target) #}
    <div id="typing-indicator" class="htmx-indicator flex justify-start mb-3">
      <div class="flex items-start gap-2.5">
        <div class="w-7 h-7 bg-gradient-to-br from-rose-400 to-pink-600 rounded-full flex items-center justify-center flex-shrink-0">
          <span class="text-white text-xs font-bold">H</span>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl rounded-bl-sm px-4 py-3">
          <div class="flex gap-1">
            <span class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay:0ms"></span>
            <span class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay:150ms"></span>
            <span class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay:300ms"></span>
          </div>
        </div>
      </div>
    </div>

  </div>

  {# Input form #}
  <div class="mt-3 flex-shrink-0">
    <form
      hx-post="{{ url('ai_engine:coach', rel_pk=relationship.pk) }}"
      hx-target="#chat-messages"
      hx-swap="beforeend"
      hx-indicator="#typing-indicator"
      hx-on::after-request="this.reset(); document.getElementById('chat-messages').scrollTop = 999999"
      class="flex gap-2">
      {{ csrf_input }}
      <input
        type="text"
        name="message"
        autocomplete="off"
        placeholder="Ask your relationship coach…"
        required
        class="flex-1 px-4 py-3 bg-white border border-gray-200 rounded-xl text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-rose-300 focus:border-transparent">
      <button type="submit"
        class="bg-rose-500 hover:bg-rose-600 text-white p-3 rounded-xl transition-colors flex-shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
        </svg>
      </button>
    </form>
    <p class="text-xs text-gray-400 text-center mt-2">HarmonyAI is not a substitute for professional therapy.</p>
  </div>

</div>

<style>
.htmx-indicator { display: none; }
.htmx-request #typing-indicator { display: flex; }
</style>

<script>
  const msgs = document.getElementById('chat-messages');
  if (msgs) msgs.scrollTop = msgs.scrollHeight;
</script>
{% endblock %}
