{% if report.error %}
<div class="p-4 bg-red-50 border border-red-200 rounded-2xl text-sm text-red-600">{{ report.error }}</div>
{% else %}
<div class="space-y-5">

  {# Headline #}
  <div class="bg-gradient-to-r from-rose-500 to-pink-600 rounded-2xl p-6 text-white">
    <p class="text-xs font-semibold uppercase tracking-wider opacity-80 mb-2">Weekly Report</p>
    <h3 class="text-xl font-bold leading-tight">{{ report.headline }}</h3>
  </div>

  {# Mood + Connection summaries #}
  <div class="grid grid-cols-1 gap-4">
    {% if report.mood_summary %}
    <div class="bg-white rounded-2xl border border-gray-200 p-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-2">Mood This Week</p>
      <p class="text-sm text-gray-700 leading-relaxed">{{ report.mood_summary }}</p>
    </div>
    {% endif %}
    {% if report.connection_summary %}
    <div class="bg-white rounded-2xl border border-gray-200 p-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-2">Connection This Week</p>
      <p class="text-sm text-gray-700 leading-relaxed">{{ report.connection_summary }}</p>
    </div>
    {% endif %}
  </div>

  {# Highlights #}
  {% if report.highlights %}
  <div class="bg-green-50 border border-green-200 rounded-2xl p-4">
    <p class="text-xs font-semibold uppercase tracking-wider text-green-700 mb-3">Highlights</p>
    <ul class="space-y-2">
      {% for h in report.highlights %}
      <li class="flex items-start gap-2 text-sm text-gray-700">
        <span class="text-green-500 font-bold mt-0.5">✓</span>{{ h }}
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  {# Areas to watch #}
  {% if report.areas_to_watch %}
  <div class="bg-amber-50 border border-amber-200 rounded-2xl p-4">
    <p class="text-xs font-semibold uppercase tracking-wider text-amber-700 mb-3">Areas to Watch</p>
    <ul class="space-y-2">
      {% for a in report.areas_to_watch %}
      <li class="flex items-start gap-2 text-sm text-gray-700">
        <span class="text-amber-500 mt-0.5">!</span>{{ a }}
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  {# This week's focus #}
  {% if report.this_week_focus %}
  <div class="bg-rose-600 text-white rounded-2xl p-4">
    <p class="text-xs font-semibold uppercase tracking-wider opacity-80 mb-2">This Week's Focus</p>
    <p class="text-sm font-medium">{{ report.this_week_focus }}</p>
  </div>
  {% endif %}

  {# Affirmation #}
  {% if report.affirmation %}
  <div class="text-center py-2">
    <p class="text-sm text-gray-500 italic">"{{ report.affirmation }}"</p>
  </div>
  {% endif %}

</div>
{% endif %}
