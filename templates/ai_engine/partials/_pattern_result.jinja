{% if result.error %}
<div class="p-3 bg-red-50 border border-red-200 rounded-xl text-sm text-red-600">{{ result.error }}</div>
{% else %}
<div class="bg-indigo-50 border border-indigo-200 rounded-2xl p-5 space-y-4">

  <div class="flex items-center gap-2">
    <span class="text-indigo-600 font-bold text-sm">✦ 30-Day Pattern Insights</span>
  </div>

  {# Trends row #}
  <div class="grid grid-cols-2 gap-3">
    <div class="bg-white rounded-xl p-3 border border-indigo-100 text-center">
      <p class="text-xs text-gray-500 mb-1">Mood Trend</p>
      <p class="text-lg font-bold
        {% if result.mood_trend == 'improving' %}text-green-500
        {% elif result.mood_trend == 'declining' %}text-red-500
        {% else %}text-yellow-500{% endif %}">
        {% if result.mood_trend == 'improving' %}↑{% elif result.mood_trend == 'declining' %}↓{% else %}→{% endif %}
        {{ result.mood_trend | title }}
      </p>
    </div>
    <div class="bg-white rounded-xl p-3 border border-indigo-100 text-center">
      <p class="text-xs text-gray-500 mb-1">Connection Trend</p>
      <p class="text-lg font-bold
        {% if result.connection_trend == 'improving' %}text-green-500
        {% elif result.connection_trend == 'declining' %}text-red-500
        {% else %}text-yellow-500{% endif %}">
        {% if result.connection_trend == 'improving' %}↑{% elif result.connection_trend == 'declining' %}↓{% else %}→{% endif %}
        {{ result.connection_trend | title }}
      </p>
    </div>
  </div>

  {# Primary concern #}
  {% if result.primary_concern %}
  <div class="bg-white rounded-xl p-3 border border-indigo-100">
    <p class="text-xs font-semibold text-indigo-700 mb-1">Primary Concern</p>
    <p class="text-sm text-gray-700">{{ result.primary_concern }}</p>
  </div>
  {% endif %}

  {# Positive patterns #}
  {% if result.positive_patterns %}
  <div>
    <p class="text-xs font-semibold uppercase tracking-wider text-green-700 mb-2">Positive Patterns</p>
    <ul class="space-y-1">
      {% for p in result.positive_patterns %}
      <li class="flex items-start gap-2 text-sm text-gray-700"><span class="text-green-500">✓</span>{{ p }}</li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  {# Risk factors #}
  {% if result.risk_factors %}
  <div>
    <p class="text-xs font-semibold uppercase tracking-wider text-orange-700 mb-2">Risk Factors</p>
    <ul class="space-y-1">
      {% for r in result.risk_factors %}
      <li class="flex items-start gap-2 text-sm text-gray-700"><span class="text-orange-400">!</span>{{ r }}</li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  {# Weekly focus #}
  {% if result.weekly_focus %}
  <div class="bg-indigo-600 text-white rounded-xl p-3">
    <p class="text-xs font-semibold mb-1">This Week's Focus</p>
    <p class="text-sm">{{ result.weekly_focus }}</p>
  </div>
  {% endif %}

</div>
{% endif %}
