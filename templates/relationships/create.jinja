{% extends "layouts/app.jinja" %}
{% block title %}New Relationship{% endblock %}
{% block page_title %}Add Relationship{% endblock %}

{% block content %}
<div class="max-w-lg">
  <div class="bg-white rounded-2xl border border-gray-200 p-8">
    <p class="text-gray-500 text-sm mb-6">Choose the type of relationship to track. You'll get an invite link to share with the other person.</p>
    <form method="post" action="{{ url('relationships:create') }}">
      {{ csrf_input }}
      <div class="grid grid-cols-2 gap-3 mb-6" x-data="{ selected: 'couple' }">
        {% set types = [
          ('couple', '💑', 'Couple', 'Romantic partner'),
          ('parent_child', '👨‍👧', 'Parent / Child', 'Family bond'),
          ('friends', '🤝', 'Friends', 'Close friendship'),
          ('business', '💼', 'Business', 'Co-founder or partner'),
        ] %}
        {% for value, emoji, label, desc in types %}
        <label class="relative cursor-pointer">
          <input type="radio" name="relationship_type" value="{{ value }}" class="sr-only"
                 @click="selected = '{{ value }}'"
                 {{ 'checked' if loop.first else '' }}>
          <div class="border-2 rounded-xl p-4 transition-all"
               :class="selected === '{{ value }}' ? 'border-rose-500 bg-rose-50' : 'border-gray-200 hover:border-gray-300'">
            <span class="text-2xl block mb-1">{{ emoji }}</span>
            <p class="font-semibold text-sm text-gray-900">{{ label }}</p>
            <p class="text-xs text-gray-500">{{ desc }}</p>
          </div>
        </label>
        {% endfor %}
      </div>
      <button type="submit" class="w-full bg-rose-500 text-white py-3 rounded-xl font-semibold hover:bg-rose-600 transition-colors">
        Create & Get Invite Link
      </button>
    </form>
  </div>
</div>
{% endblock %}
