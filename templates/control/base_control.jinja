<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}Mission Control{% endblock %} — HarmonyAI</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <script src="https://unpkg.com/htmx.org@1.9.12"></script>
  <style>[x-cloak] { display: none !important; }</style>
</head>
<body class="h-full bg-gray-950 text-gray-100 antialiased">
<div class="flex h-full" x-data="{ sidebarOpen: true }">

  {# Sidebar #}
  <aside class="w-60 flex-shrink-0 bg-gray-900 border-r border-gray-800 flex flex-col">
    <div class="flex items-center gap-3 px-5 py-4 border-b border-gray-800">
      <div class="w-7 h-7 bg-rose-500 rounded flex items-center justify-center">
        <span class="text-white font-bold text-xs">H</span>
      </div>
      <div>
        <p class="font-semibold text-sm text-white">HarmonyAI</p>
        <p class="text-xs text-gray-500">Mission Control</p>
      </div>
    </div>
    <nav class="flex-1 px-3 py-4 space-y-1">
      <a href="{{ url('control:dashboard') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-400 hover:text-white hover:bg-gray-800 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        Overview
      </a>
      <a href="{{ url('control:users') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-400 hover:text-white hover:bg-gray-800 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        Users
      </a>
    </nav>
    <div class="px-3 py-3 border-t border-gray-800">
      <a href="{{ url('dashboard:home') }}" class="flex items-center gap-2 px-3 py-2 text-xs text-gray-500 hover:text-gray-300 transition-colors">
        ← Back to App
      </a>
    </div>
  </aside>

  {# Main #}
  <div class="flex-1 flex flex-col overflow-hidden">
    <header class="bg-gray-900 border-b border-gray-800 px-6 py-4 flex items-center justify-between">
      <h1 class="font-semibold text-white">{% block page_title %}Dashboard{% endblock %}</h1>
      <span class="text-xs text-gray-500">{{ request.user.email }}</span>
    </header>
    <main class="flex-1 overflow-y-auto p-6">
      {% block content %}{% endblock %}
    </main>
  </div>
</div>
</body>
</html>
