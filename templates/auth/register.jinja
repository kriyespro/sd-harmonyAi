{% extends "base.jinja" %}
{% block title %}Create Account{% endblock %}

{% block body %}
<div class="min-h-full flex">
  {# Left panel #}
  <div class="hidden lg:flex lg:w-1/2 bg-gradient-to-br from-rose-500 to-pink-600 flex-col justify-center px-16">
    <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center mb-8">
      <span class="text-white font-bold text-lg">H</span>
    </div>
    <h2 class="text-3xl font-bold text-white mb-4">Build stronger relationships.</h2>
    <p class="text-rose-100 text-lg leading-relaxed">AI detects small signals before they become big problems. Start with one relationship.</p>
    <ul class="mt-8 space-y-3">
      <li class="flex items-center gap-3 text-rose-100 text-sm">
        <span class="text-white">✓</span> Daily mood tracking in 10 seconds
      </li>
      <li class="flex items-center gap-3 text-rose-100 text-sm">
        <span class="text-white">✓</span> AI conflict pattern detection
      </li>
      <li class="flex items-center gap-3 text-rose-100 text-sm">
        <span class="text-white">✓</span> Proactive suggestions, not accusations
      </li>
    </ul>
  </div>

  {# Right panel #}
  <div class="flex-1 flex items-center justify-center px-6 py-12 bg-white">
    <div class="w-full max-w-sm">
      <div class="lg:hidden flex items-center gap-2 mb-8">
        <div class="w-8 h-8 bg-rose-500 rounded-lg flex items-center justify-center">
          <span class="text-white font-bold text-sm">H</span>
        </div>
        <span class="font-semibold text-gray-900">HarmonyAI</span>
      </div>

      <h1 class="text-2xl font-bold text-gray-900 mb-2">Create account</h1>
      <p class="text-gray-500 mb-8">Already have one? <a href="{{ url('users:login') }}" class="text-rose-500 hover:text-rose-600">Sign in</a></p>

      <form method="post" action="{{ url('users:register') }}" class="space-y-4">
        {{ csrf_input }}
        {% if form.non_field_errors() %}
          <div class="bg-red-50 border border-red-200 rounded-lg p-3 text-sm text-red-600">
            {% for error in form.non_field_errors() %}{{ error }}{% endfor %}
          </div>
        {% endif %}
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">First Name</label>
            <input type="text" name="first_name" value="{{ form.first_name.value() or '' }}"
                   class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent"
                   placeholder="Raj" autofocus>
            {% if form.first_name.errors %}
              <p class="text-red-500 text-xs mt-1">{{ form.first_name.errors|join(', ') }}</p>
            {% endif %}
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Last Name</label>
            <input type="text" name="last_name" value="{{ form.last_name.value() or '' }}"
                   class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent"
                   placeholder="Sharma">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
          <input type="email" name="email" value="{{ form.email.value() or '' }}"
                 class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent"
                 placeholder="you@example.com">
          {% if form.email.errors %}
            <p class="text-red-500 text-xs mt-1">{{ form.email.errors|join(', ') }}</p>
          {% endif %}
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
          <input type="password" name="password"
                 class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent"
                 placeholder="Min. 8 characters">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Confirm Password</label>
          <input type="password" name="password_confirm"
                 class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent"
                 placeholder="Repeat password">
        </div>
        <button type="submit"
                class="w-full bg-rose-500 text-white py-2.5 rounded-lg font-semibold hover:bg-rose-600 transition-colors">
          Create Account
        </button>
        <p class="text-xs text-gray-400 text-center">AI provides observations only — never diagnoses or accusations.</p>
      </form>
    </div>
  </div>
</div>
{% endblock %}
