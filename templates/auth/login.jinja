{% extends "base.jinja" %}
{% block title %}Login{% endblock %}

{% block body %}
<div class="min-h-full flex">
  {# Left panel #}
  <div class="hidden lg:flex lg:w-1/2 bg-gradient-to-br from-rose-500 to-pink-600 flex-col justify-center px-16">
    <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center mb-8">
      <span class="text-white font-bold text-lg">H</span>
    </div>
    <h2 class="text-3xl font-bold text-white mb-4">Welcome back.</h2>
    <p class="text-rose-100 text-lg">Your relationships deserve daily attention. Small habits, big results.</p>
  </div>

  {# Right panel #}
  <div class="flex-1 flex items-center justify-center px-6 py-12 bg-white">
    <div class="w-full max-w-sm">
      <div class="lg:hidden flex items-center gap-2 mb-8">
        <div class="w-8 h-8 bg-rose-500 rounded-lg flex items-center justify-center">
          <span class="text-white font-bold text-sm">H</span>
        </div>
        <span class="font-semibold text-gray-900">HarmonyAI</span>
      </div>

      <h1 class="text-2xl font-bold text-gray-900 mb-2">Sign in</h1>
      <p class="text-gray-500 mb-8">Don't have an account? <a href="{{ url('users:register') }}" class="text-rose-500 hover:text-rose-600">Register free</a></p>

      <form method="post" action="{{ url('users:login') }}" class="space-y-4">
        {{ csrf_input }}
        {% if form.non_field_errors() %}
          <div class="bg-red-50 border border-red-200 rounded-lg p-3 text-sm text-red-600">
            {% for error in form.non_field_errors() %}{{ error }}{% endfor %}
          </div>
        {% endif %}
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
          <input type="email" name="username" value="{{ form.username.value() or '' }}"
                 class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent"
                 placeholder="you@example.com" autofocus>
          {% if form.username.errors %}
            <p class="text-red-500 text-xs mt-1">{{ form.username.errors|join(', ') }}</p>
          {% endif %}
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
          <input type="password" name="password"
                 class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent"
                 placeholder="••••••••">
        </div>
        <button type="submit"
                class="w-full bg-rose-500 text-white py-2.5 rounded-lg font-semibold hover:bg-rose-600 transition-colors">
          Sign In
        </button>
      </form>
    </div>
  </div>
</div>
{% endblock %}
